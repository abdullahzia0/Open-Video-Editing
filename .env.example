# Copy to .env, then replace roots with directories you authorize for import.
# JSON arrays are required. Empty roots deny all source imports.
OVE_DATA_DIR=.ove
OVE_ALLOWED_LOCAL_ROOTS=[]
OVE_FFMPEG_PATH=ffmpeg
OVE_FFPROBE_PATH=ffprobe
OVE_FFMPEG_THREADS=2
OVE_MAX_UPLOAD_BYTES=2000000000
OVE_MAX_DURATION_SECONDS=14400
OVE_MAX_PIXELS=33177600
OVE_MAX_OUTPUT_BYTES=4000000000
OVE_JOB_TIMEOUT_SECONDS=3600
OVE_PROBE_TIMEOUT_SECONDS=30
OVE_OFFLINE=true
OVE_TRANSCRIPTION_PROVIDER=disabled
# OVE_TRANSCRIPTION_MODEL_DIR=/absolute/path/to/ctranslate2-model
OVE_TRANSCRIPTION_DEVICE=cpu
OVE_TRANSCRIPTION_COMPUTE_TYPE=int8
# OVE_PRESET_DIR=/absolute/path/to/custom/presets
# Canva/cloud credentials are intentionally not accepted: those adapters are not implemented.
